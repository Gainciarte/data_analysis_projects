table Deliveries

	column LineID
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: LineID

	column ProjectCode
		dataType: string
		summarizeBy: none
		sourceColumn: ProjectCode

	column Country
		dataType: string
		summarizeBy: none
		dataCategory: Country
		sourceColumn: Country

	column ManagedBy
		dataType: string
		summarizeBy: none
		sourceColumn: ManagedBy

	column FulfillVia
		dataType: string
		summarizeBy: none
		sourceColumn: FulfillVia

	column IncoTerm
		dataType: string
		summarizeBy: none
		sourceColumn: IncoTerm

	column ShipmentMode
		dataType: string
		summarizeBy: none
		sourceColumn: ShipmentMode

	column ProductGroup
		dataType: string
		summarizeBy: none
		sourceColumn: ProductGroup

	column SubClassification
		dataType: string
		summarizeBy: none
		sourceColumn: SubClassification

	column Vendor
		dataType: string
		summarizeBy: none
		sourceColumn: Vendor

	column Sourcing
		dataType: string
		summarizeBy: none
		sourceColumn: Sourcing

	column ManufacturingSite
		dataType: string
		summarizeBy: none
		sourceColumn: ManufacturingSite

	column ScheduledDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: ScheduledDate

	column DeliveredDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: DeliveredDate

	column Quantity
		dataType: double
		formatString: #,0
		summarizeBy: sum
		sourceColumn: Quantity

	column LineValue
		dataType: double
		formatString: $#,0
		summarizeBy: sum
		sourceColumn: LineValue

	column UnitPrice
		dataType: double
		formatString: $#,0.00
		summarizeBy: sum
		sourceColumn: UnitPrice

	column WeightKg
		dataType: double
		formatString: #,0
		summarizeBy: sum
		sourceColumn: WeightKg

	column FreightUSD
		dataType: double
		formatString: $#,0
		summarizeBy: sum
		sourceColumn: FreightUSD

	column InsuranceUSD
		dataType: double
		formatString: $#,0
		summarizeBy: sum
		sourceColumn: InsuranceUSD

	column FreightType
		dataType: string
		summarizeBy: none
		sourceColumn: FreightType

	column DaysLate
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: DaysLate

	column OnTime
		dataType: string
		summarizeBy: none
		sourceColumn: OnTime

	column ScheduleStatus = SWITCH(TRUE(), ISBLANK(Deliveries[DaysLate]), "No date", Deliveries[DaysLate] < 0, "Early", Deliveries[DaysLate] = 0, "On schedule", Deliveries[DaysLate] <= 7, "Late 1-7 d", Deliveries[DaysLate] <= 30, "Late 8-30 d", "Late > 30 d")
		dataType: string
		summarizeBy: none
		sortByColumn: ScheduleOrder

	column ScheduleOrder = SWITCH(TRUE(), ISBLANK(Deliveries[DaysLate]), 0, Deliveries[DaysLate] < 0, 1, Deliveries[DaysLate] = 0, 2, Deliveries[DaysLate] <= 7, 3, Deliveries[DaysLate] <= 30, 4, 5)
		dataType: int64
		formatString: 0
		summarizeBy: none

	measure Projects = DISTINCTCOUNT(Deliveries[ProjectCode])
		formatString: #,0
		displayFolder: Portfolio

	measure 'Delivery Lines' = COUNTROWS(Deliveries)
		formatString: #,0
		displayFolder: Portfolio

	measure 'Value Delivered' = SUM(Deliveries[LineValue])
		formatString: $#,0.0
		displayFolder: Portfolio

	measure 'On-Time %' = DIVIDE(CALCULATE(COUNTROWS(Deliveries), Deliveries[OnTime] = "On time"), CALCULATE(COUNTROWS(Deliveries), NOT ISBLANK(Deliveries[OnTime])))
		formatString: 0.0%
		displayFolder: Schedule

	measure 'Late Lines' = CALCULATE(COUNTROWS(Deliveries), Deliveries[OnTime] = "Late")
		formatString: #,0
		displayFolder: Schedule

	measure 'Seriously Late Lines (>30 d)' = CALCULATE(COUNTROWS(Deliveries), Deliveries[DaysLate] > 30)
		formatString: #,0
		displayFolder: Schedule

	measure 'Avg Days Late (late lines)' = CALCULATE(AVERAGE(Deliveries[DaysLate]), Deliveries[OnTime] = "Late")
		formatString: 0.0
		displayFolder: Schedule

	measure 'Avg Schedule Variance (days)' = AVERAGE(Deliveries[DaysLate])
		formatString: 0.0;-0.0
		displayFolder: Schedule

	measure 'Value Late' = CALCULATE([Value Delivered], Deliveries[OnTime] = "Late")
		formatString: $#,0.0
		displayFolder: Schedule

	measure 'Projects With >=1 Late Line' = CALCULATE(DISTINCTCOUNT(Deliveries[ProjectCode]), Deliveries[OnTime] = "Late")
		formatString: #,0
		displayFolder: Portfolio

	measure 'Worst Projects Late Lines' =
			VAR r = RANKX(ALL(Deliveries[ProjectCode]), [Late Lines], , DESC, Dense)
			RETURN IF(r <= 10, [Late Lines])
		formatString: #,0
		displayFolder: Portfolio

	partition Deliveries = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\\scms_lines.csv"), [Delimiter=",", Columns=23, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"LineID", Int64.Type}, {"ProjectCode", type text}, {"Country", type text}, {"ManagedBy", type text}, {"FulfillVia", type text}, {"IncoTerm", type text}, {"ShipmentMode", type text}, {"ProductGroup", type text}, {"SubClassification", type text}, {"Vendor", type text}, {"Sourcing", type text}, {"ManufacturingSite", type text}, {"ScheduledDate", type date}, {"DeliveredDate", type date}, {"Quantity", type number}, {"LineValue", type number}, {"UnitPrice", type number}, {"WeightKg", type number}, {"FreightUSD", type number}, {"InsuranceUSD", type number}, {"FreightType", type text}, {"DaysLate", Int64.Type}, {"OnTime", type text}}, "en-US")
				in
					Typed
