table Shipments

	column LineID
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: LineID

	column ProjectCode
		dataType: string
		summarizeBy: none
		sourceColumn: ProjectCode

	column Country
		dataType: string
		summarizeBy: none
		dataCategory: Country
		sourceColumn: Country

	column ManagedBy
		dataType: string
		summarizeBy: none
		sourceColumn: ManagedBy

	column FulfillVia
		dataType: string
		summarizeBy: none
		sourceColumn: FulfillVia

	column IncoTerm
		dataType: string
		summarizeBy: none
		sourceColumn: IncoTerm

	column ShipmentMode
		dataType: string
		summarizeBy: none
		sourceColumn: ShipmentMode

	column ProductGroup
		dataType: string
		summarizeBy: none
		sourceColumn: ProductGroup

	column SubClassification
		dataType: string
		summarizeBy: none
		sourceColumn: SubClassification

	column Vendor
		dataType: string
		summarizeBy: none
		sourceColumn: Vendor

	column Sourcing
		dataType: string
		summarizeBy: none
		sourceColumn: Sourcing

	column ManufacturingSite
		dataType: string
		summarizeBy: none
		sourceColumn: ManufacturingSite

	column ScheduledDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: ScheduledDate

	column DeliveredDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: DeliveredDate

	column Quantity
		dataType: double
		formatString: #,0
		summarizeBy: sum
		sourceColumn: Quantity

	column LineValue
		dataType: double
		formatString: $#,0
		summarizeBy: sum
		sourceColumn: LineValue

	column UnitPrice
		dataType: double
		formatString: $#,0.00
		summarizeBy: sum
		sourceColumn: UnitPrice

	column WeightKg
		dataType: double
		formatString: #,0
		summarizeBy: sum
		sourceColumn: WeightKg

	column FreightUSD
		dataType: double
		formatString: $#,0
		summarizeBy: sum
		sourceColumn: FreightUSD

	column InsuranceUSD
		dataType: double
		formatString: $#,0
		summarizeBy: sum
		sourceColumn: InsuranceUSD

	column FreightType
		dataType: string
		summarizeBy: none
		sourceColumn: FreightType

	column DaysLate
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: DaysLate

	column OnTime
		dataType: string
		summarizeBy: none
		sourceColumn: OnTime

	measure 'Total Spend' = SUM(Shipments[LineValue])
		formatString: $#,0.0
		displayFolder: Spend

	measure 'Order Lines' = COUNTROWS(Shipments)
		formatString: #,0
		displayFolder: Spend

	measure 'Active Vendors' = CALCULATE(DISTINCTCOUNT(Shipments[Vendor]), Shipments[Sourcing] = "Direct from vendor")
		formatString: #,0
		displayFolder: Vendors

	measure 'Units Procured' = SUM(Shipments[Quantity])
		formatString: #,0.0
		displayFolder: Spend

	measure 'Avg Unit Price' = DIVIDE([Total Spend], [Units Procured])
		formatString: $#,0.00
		displayFolder: Spend

	measure 'Direct Vendor Spend' = CALCULATE([Total Spend], Shipments[Sourcing] = "Direct from vendor")
		formatString: $#,0.0
		displayFolder: Vendors

	measure 'RDC Stock Share of Spend' = DIVIDE(CALCULATE([Total Spend], Shipments[Sourcing] = "From regional stock (RDC)"), [Total Spend])
		formatString: 0.0%
		displayFolder: Vendors

	measure 'Top 10 Vendor Spend' =
			VAR r = RANKX(ALL(Shipments[Vendor]), [Direct Vendor Spend], , DESC, Dense)
			RETURN IF(r <= 10, [Direct Vendor Spend])
		formatString: $#,0.0
		displayFolder: Vendors

	measure 'Top 3 Vendor Share' = DIVIDE(SUMX(TOPN(3, VALUES(Shipments[Vendor]), [Direct Vendor Spend]), [Direct Vendor Spend]), [Direct Vendor Spend])
		formatString: 0.0%
		displayFolder: Vendors

	measure 'Spend YoY %' =
			VAR prev = CALCULATE([Total Spend], SAMEPERIODLASTYEAR('Calendar'[Date]))
			RETURN IF(HASONEVALUE('Calendar'[Year]), DIVIDE([Total Spend] - prev, prev))
		formatString: 0.0%;-0.0%
		displayFolder: Spend

	measure 'Freight Spend' = SUM(Shipments[FreightUSD])
		formatString: $#,0.0
		displayFolder: Freight

	measure 'Freight % of Spend' = DIVIDE([Freight Spend], CALCULATE([Total Spend], Shipments[FreightType] = "Numeric"))
		formatString: 0.0%
		displayFolder: Freight

	measure 'Late Delivery %' = DIVIDE(CALCULATE(COUNTROWS(Shipments), Shipments[OnTime] = "Late"), CALCULATE(COUNTROWS(Shipments), NOT ISBLANK(Shipments[OnTime])))
		formatString: 0.0%
		displayFolder: Delivery

	measure 'Avg Days Late (late lines)' = CALCULATE(AVERAGE(Shipments[DaysLate]), Shipments[OnTime] = "Late")
		formatString: 0.0
		displayFolder: Delivery

	partition Shipments = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\\scms_lines.csv"), [Delimiter=",", Columns=23, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"LineID", Int64.Type}, {"ProjectCode", type text}, {"Country", type text}, {"ManagedBy", type text}, {"FulfillVia", type text}, {"IncoTerm", type text}, {"ShipmentMode", type text}, {"ProductGroup", type text}, {"SubClassification", type text}, {"Vendor", type text}, {"Sourcing", type text}, {"ManufacturingSite", type text}, {"ScheduledDate", type date}, {"DeliveredDate", type date}, {"Quantity", type number}, {"LineValue", type number}, {"UnitPrice", type number}, {"WeightKg", type number}, {"FreightUSD", type number}, {"InsuranceUSD", type number}, {"FreightType", type text}, {"DaysLate", Int64.Type}, {"OnTime", type text}}, "en-US")
				in
					Typed
